# Node dependencies (installed inside the container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local secret files (never bake into image)
.env
.env.*
!.env.example
!.env.docker.example

# Git and version control
.git
.gitignore
.github

# Local test database and cache
.mongo-data
data/
backups/*
!backups/.gitkeep
uploads/*
!uploads/.gitkeep

# IDE and OS artifacts
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.swo

# Temporary and test outputs
coverage
.nyc_output
