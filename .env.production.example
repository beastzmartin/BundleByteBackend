# ==============================================================================
# BundleByte Backend - Production Environment Configuration
# ==============================================================================
# Use this when deploying the backend on Render, Railway, VPS, or Vercel
# ==============================================================================

PORT=5001
NODE_ENV=production

# Frontend Client URL (allowed by CORS and used in emails & password reset links)
CLIENT_URL=https://bundlebytestore.com

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# Replace with your MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://codewithbeastz_db_user:<db_password>@cluster0.6mmhcc0.mongodb.net/bundlebyte_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=bundlebyte_prod_jwt_super_secret_key_random_64_chars_min_replace_me
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ------------------------------------------------------------------------------
# Payment Gateways
# ------------------------------------------------------------------------------
# Set to false in real production when live gateways are active
MOCK_PAYMENT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# SMTP Email Settings (Hostinger / Brevo / SendGrid / Google Workspace)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=support@bundlebytestore.com
SMTP_PASS=YOUR_EMAIL_PASSWORD
FROM_EMAIL=support@bundlebytestore.com
FROM_NAME="BundleByte Marketplace"

# ------------------------------------------------------------------------------
# OAuth & Social Integrations
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

