# ==============================================================================
# BundleByte Backend - Docker Environment Configuration Template
# ==============================================================================
# Rename this file to .env before running `docker compose up` or `docker run`
# ==============================================================================

PORT=5001
NODE_ENV=production

# Frontend Client URL (allowed by CORS and used in emails & password reset links)
CLIENT_URL=https://your-frontend-domain.com

# ------------------------------------------------------------------------------
# MongoDB Database Connection
# ------------------------------------------------------------------------------
# Option A: If using the included Docker Compose MongoDB service:
MONGODB_URI=mongodb://mongo:27017/bundlebyte_db

# Option B: If connecting to an external MongoDB Atlas cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/bundlebyte_db?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=bundlebyte_docker_secure_jwt_secret_change_me_to_random_string_64_chars
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# ------------------------------------------------------------------------------
# Payment Gateways
# ------------------------------------------------------------------------------
MOCK_PAYMENT_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# SMTP Email Settings (Hostinger / Resend / Brevo / SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=support@bundlebyte.com
SMTP_PASS=
FROM_EMAIL=support@bundlebyte.com
FROM_NAME="BundleByte Marketplace"

# ------------------------------------------------------------------------------
# OAuth & Social Integrations (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
